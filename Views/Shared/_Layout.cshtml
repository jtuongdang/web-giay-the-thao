<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SNEAKERZONE | Cửa hàng giày thể thao chính hãng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Announcement Bar -->
    <div class="top-bar py-1 text-center text-white small fw-semibold">
        <span>🔥 MIỄN PHÍ GIAO HÀNG TOÀN QUỐC CHO ĐƠN TỪ 1.500.000Đ &bull; ĐỔI TRẢ TRONG 30 NGÀY</span>
    </div>

    <!-- Main Navigation Header (Sticky) -->
    <header class="main-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
            <div class="container">
                <a class="navbar-brand fw-extrabold fs-3 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">⚡</span>
                    <span class="brand-text">SNEAKER<span class="text-accent">ZONE</span></span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-bold text-uppercase fs-7">
                        <li class="nav-item">
                            <a class="nav-link px-3 active" asp-controller="Home" asp-action="Index">Tất Cả</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index" asp-route-brand="Nike">Nike</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index" asp-route-brand="Adidas">Adidas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index" asp-route-brand="Jordan">Jordan</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index" asp-route-brand="Puma">Puma</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <form class="d-flex position-relative header-search" method="get" asp-controller="Home" asp-action="Index">
                            <input class="form-control rounded-pill pe-5 search-input" type="search" name="search" placeholder="Tìm giày..." aria-label="Search" value="@Context.Request.Query["search"]">
                            <button class="btn search-btn position-absolute end-0 top-0 h-100 pe-3 text-muted" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>
                        <a href="#cart" class="btn btn-outline-light rounded-pill position-relative px-3 py-2 cart-btn">
                            <i class="bi bi-bag-fill fs-6"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-accent">
                                2
                                <span class="visually-hidden">sản phẩm trong giỏ</span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="main-footer bg-black text-light pt-5 pb-3">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold fs-4 mb-3 d-flex align-items-center gap-2">
                        <span>⚡</span> SNEAKER<span class="text-accent">ZONE</span>
                    </h5>
                    <p class="text-secondary small pe-lg-4">
                        Hệ thống phân phối giày thể thao chính hãng hàng đầu từ các thương hiệu Nike, Adidas, Jordan, Puma. Cam kết 100% chính hãng, bảo hành trọn đời.
                    </p>
                    <div class="d-flex gap-3 social-links">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-uppercase mb-3">Thương hiệu</h6>
                    <ul class="list-unstyled footer-links small">
                        <li><a asp-controller="Home" asp-action="Index" asp-route-brand="Nike">Nike Shoes</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-brand="Adidas">Adidas Originals</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-brand="Jordan">Air Jordan</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-brand="Puma">Puma Motorsport</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase mb-3">Chính sách & Hỗ trợ</h6>
                    <ul class="list-unstyled footer-links small">
                        <li><a href="#">Hướng dẫn chọn kích cỡ (Size guide)</a></li>
                        <li><a href="#">Chính sách đổi trả trong 30 ngày</a></li>
                        <li><a href="#">Chính sách bảo hành & bảo mật</a></li>
                        <li><a href="#">Hệ thống cửa hàng trên toàn quốc</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase mb-3">Nhận khuyến mãi độc quyền</h6>
                    <p class="text-secondary small">Đăng ký để nhận voucher giảm 10% cho đơn hàng đầu tiên!</p>
                    <div class="input-group mb-3">
                        <input type="email" class="form-control rounded-start-pill" placeholder="Email của bạn...">
                        <button class="btn btn-accent rounded-end-pill px-3 fw-bold" type="button">Gửi</button>
                    </div>
                </div>
            </div>
            <hr class="border-secondary opacity-25">
            <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary">
                <p class="mb-0">&copy; 2026 SNEAKERZONE. Toàn bộ bản quyền thuộc về dự án Quản Lý Bán Giày.</p>
                <div class="d-flex gap-3">
                    <span>Thanh toán an toàn:</span>
                    <i class="bi bi-credit-card"></i>
                    <i class="bi bi-qr-code"></i>
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
